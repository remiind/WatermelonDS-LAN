            uint evb = (pc.mezcla >> 6u) & 0x1Fu;
            uint bancoB = (pc.mezcla >> 11u) & 0x3u;
            int rA5 = color.r >> 1; int gA5 = color.g >> 1; int bA5 = color.b >> 1;
            int rB5; int gB5; int bB5; int aB;
            if ((pc.mezcla & (1u << 13u)) != 0u)
            {
                vec4 tb = leeCap(bancoB & 1u,
                                 ivec2(int(xSalida), int(filaSalida)));

                rB5 = int(uint(tb.b * 255.0 + 0.5) >> 3u);
                gB5 = int(uint(tb.g * 255.0 + 0.5) >> 3u);
                bB5 = int(uint(tb.r * 255.0 + 0.5) >> 3u);
                aB = (tb.a >= 0.5) ? 1 : 0;
            }
            else
            {
                uint c16b = leerU16(kAtlasBancos + bancoB * 0x20000u
                                    + (linea * 256u + x) * 2u);
                rB5 = int(c16b & 0x1Fu);
                gB5 = int((c16b >> 5u) & 0x1Fu);
                bB5 = int((c16b >> 10u) & 0x1Fu);
                aB = int(c16b >> 15u);
            }
            int rD5 = min(31, (rA5 * int(eva) + rB5 * aB * int(evb) + 8) >> 4);
            int gD5 = min(31, (gA5 * int(eva) + gB5 * aB * int(evb) + 8) >> 4);
            int bD5 = min(31, (bA5 * int(eva) + bB5 * aB * int(evb) + 8) >> 4);
            int aD = ((eva > 0u) ? 1 : 0) | ((evb > 0u) ? aB : 0);
            vCap = vec4(float(a8(bD5 << 1)) / 255.0,
                        float(a8(gD5 << 1)) / 255.0,
                        float(a8(rD5 << 1)) / 255.0,
                        float(aD));
        }
        else
        {

            int r5 = color.r >> 1;
            int g5 = color.g >> 1;
            int b5 = color.b >> 1;
            vCap = vec4(float(a8(b5 << 1)) / 255.0,
                        float(a8(g5 << 1)) / 255.0,
                        float(a8(r5 << 1)) / 255.0, 1.0);
        }

        if (((pc.escala >> 14u) & 3u) == 1u)
        {
            uint f3s = reg(0u, linea, 26u); if (f3s > 191u) f3s = linea;
            uint a5s; ivec3 c3s;
            leer3dEscala(xSalida, f3s * esc + (filaInterna - linea * esc),
                         ratio3d, a5s, c3s);
            vCap = (a5s != 0u)
                ? vec4(float(a8(c3s.b)) / 255.0, float(a8(c3s.g)) / 255.0,
                       float(a8(c3s.r)) / 255.0, 1.0)
                : vec4(1.0, 0.0, 0.0, 1.0);
        }
        if ((pc.mezcla & 0x80000000u) != 0u)
            imageStore(outImage,
                       ivec2(int(xSalida), int(filaSalida)), vCap);
        else if ((pc.escala & 0x2000000u) != 0u)
            imageStore(imgCapHighres1,
                       ivec2(int(xSalida), int(filaSalida)), vCap);
        else
            imageStore(imgCapHighres,
                       ivec2(int(xSalida), int(filaSalida)), vCap);
        return;
    }

    if (outputMode() == 3u)
    {

        fielB1Flags &= ~((1u << 20u) | (1u << 21u));
        uint idxS = ((eng * 192u + linea) * 256u + x) * 2u;
        fielB1[idxS] = uint(color.r & 0x3F) | (uint(color.g & 0x3F) << 6u)
                     | (uint(color.b & 0x3F) << 12u) | fielB1Flags;

        fielB1[idxS + 1u] = uint(topCrudoB1.r & 0x3F)
                          | (uint(topCrudoB1.g & 0x3F) << 6u)
                          | (uint(topCrudoB1.b & 0x3F) << 12u)
                          | mezcla2dSobre3dB1;
        if ((fielB1Flags & kB1Precomposed3d) != 0u)
            fielB1[idxS + 1u] = precomposed3dB1;
        return;
    }

    if (((pc.escala >> 14u) & 3u) == 3u)
        color = ivec3(63, 0, 0);
    imageStore(outImage, ivec2(int(xSalida), int(filaSalida)),
        vec4(float(a8(color.b)) / 255.0,
             float(a8(color.g)) / 255.0,
             float(a8(color.r)) / 255.0,
             1.0));
}
