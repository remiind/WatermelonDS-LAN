uint gRegBase = 0u;
uint gAtlasBase = 0u;
uint leerByte(uint off)  { off += gAtlasBase; return (atlas[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu; }
uint leerU16(uint off)   { return leerByte(off) | (leerByte(off + 1u) << 8u); }

uint reg(uint eng, uint linea, uint w) { return regs[gRegBase + (eng * 192u + linea) * 32u + w]; }

ivec3 c555a666(uint c)
{
    return ivec3((c & 0x1Fu) << 1, (c & 0x3E0u) >> 4, (c & 0x7C00u) >> 9);
}

int clamp6(int v) { return clamp(v, 0, 63); }

int a8(int v6)
{
    int base = clamp6(v6) << 2;
    return base | (base >> 6);
}

bool h5SlotCertificada(uint slot,
                       uint epochLo, uint epochHi,
                       uint productLo, uint productHi)
{
    return (epochLo | epochHi) != 0u
        && (productLo | productHi) != 0u
        && slot < 4u
        && capSeal[slot].x == productLo
        && capSeal[slot].y == productHi
        && capSeal[slot].z == 0u
        && capSeal[slot].w == 256u * 192u
        && capSeal[12u + slot].x == epochLo
        && capSeal[12u + slot].y == epochHi
        && capSeal[12u + slot].z == productLo
        && capSeal[12u + slot].w == productHi;
}

uint causalRequiredCaptureHandle(uint index)
{
    uint packed = index < 2u ? causal[14u] : causal[15u];
    return (index & 1u) == 0u ? (packed & 0xFFFFu) : (packed >> 16u);
}

bool causalRequiredCaptureSetCertified()
{
    if (!causalHeaderValid())
        return false;

    uint publication = causal[13u];
    uint requiredCount = publication & 0x7FFFFFFFu;
    if ((publication & 0x80000000u) == 0u || requiredCount > 4u)
        return false;

    for (uint index = 0u; index < requiredCount; index++)
    {
        uint handle = causalRequiredCaptureHandle(index);
        if (handle <= 1u)
            return false;
        for (uint previous = 0u; previous < index; previous++)
        {
            if (causalRequiredCaptureHandle(previous) == handle)
                return false;
        }

        uvec4 identity;
        uvec4 metadata;
        if (!causalLoadProduct(handle, identity, metadata)
            || (metadata.y & 0xFFu) != 2u
            || identity.x != causal[5u]
            || identity.y != causal[6u])
        {
            return false;
        }

        uint encodedSlot = metadata.z;
        if (encodedSlot < 1u || encodedSlot > 4u
            || !h5SlotCertificada(
                encodedSlot - 1u,
                identity.x, identity.y, identity.z, identity.w))
        {
            return false;
        }
    }
    return true;
}

bool causalRequiredCaptureSetContains(uint handle)
{
    uint requiredCount = causal[13u] & 0x7FFFFFFFu;
    for (uint index = 0u; index < requiredCount && index < 4u; index++)
    {
        if (causalRequiredCaptureHandle(index) == handle)
            return true;
    }
    return false;
}

vec4 h5LeeSlot(uint slot, ivec2 p)
{
    return slot == 3u
        ? imageLoad(imgCapHighresPrev2, p)
        : (slot == 2u
            ? imageLoad(imgCapHighresPrev, p)
            : (slot == 1u
                ? imageLoad(imgCapHighres1, p)
                : imageLoad(imgCapHighres, p)));
}

void h5StoreSlot(uint slot, ivec2 p, vec4 color)
{
    if (slot == 3u)
        imageStore(imgCapHighresPrev2, p, color);
    else if (slot == 2u)
        imageStore(imgCapHighresPrev, p, color);
    else if (slot == 1u)
        imageStore(imgCapHighres1, p, color);
    else
        imageStore(imgCapHighres, p, color);
}

void aplicaPostEffectCausal(inout ivec3 color, uint postEffect, int evy)
{
    if (postEffect == 1u && evy > 0)
    {
        color.r = clamp6(color.r + (((63 - color.r) * evy) >> 4));
        color.g = clamp6(color.g + (((63 - color.g) * evy) >> 4));
        color.b = clamp6(color.b + (((63 - color.b) * evy) >> 4));
    }
    else if (postEffect == 2u && evy > 0)
    {
        color.r = clamp6(color.r - (((color.r * evy) + 0xF) >> 4));
        color.g = clamp6(color.g - (((color.g * evy) + 0xF) >> 4));
        color.b = clamp6(color.b - (((color.b * evy) + 0xF) >> 4));
    }
}

bool ventanaActiva(uint estado2b, uint x1, uint x2, uint x)
{
    if ((estado2b & 1u) == 0u) return false;
    bool hayOn = (x1 <= x);
    bool hayOff = (x2 <= x);
    bool bitH;
    if (!hayOn && !hayOff) bitH = (estado2b & 2u) != 0u;
    else if (hayOn && !hayOff) bitH = true;
    else if (!hayOn) bitH = false;
    else bitH = (x1 > x2);
    return bitH;
}

bool objPuedeTocarBloque(uint eng, uint linea, uint bloqueX0, uint o)
{
    uint dispcnt = reg(eng, linea, 0u);
    if ((dispcnt & 0x1000u) == 0u)
        return false;

    uint oamBase = kAtlasOAM + eng * 0x400u;
    uint a01 = leerU16(oamBase + o * 8u);
    bool afin = (a01 & 0x100u) != 0u;
    if (!afin && (a01 & 0x200u) != 0u)
        return false;

    uint a1 = leerU16(oamBase + o * 8u + 2u);
    uint forma = (a01 >> 14u) & 0x3u;
    uint tam = (a1 >> 14u) & 0x3u;
    uint wpx = 8u;
    uint hpx = 8u;
    if (forma == 0u)
    {
        wpx = 8u << tam;
        hpx = wpx;
    }
    else if (forma == 1u)
    {
        wpx = (tam == 0u) ? 16u : (tam == 1u) ? 32u
            : (tam == 2u) ? 32u : 64u;
        hpx = (tam == 0u) ? 8u : (tam == 1u) ? 8u
            : (tam == 2u) ? 16u : 32u;
    }
    else
    {
        hpx = (tam == 0u) ? 16u : (tam == 1u) ? 32u
            : (tam == 2u) ? 32u : 64u;
        wpx = (tam == 0u) ? 8u : (tam == 1u) ? 8u
            : (tam == 2u) ? 16u : 32u;
    }

    uint bw = wpx;
    uint bh = hpx;
    if (afin && (a01 & 0x200u) != 0u)
    {
        bw <<= 1u;
        bh <<= 1u;
    }
    uint dy = (linea - (a01 & 0xFFu)) & 0xFFu;
    if (dy >= bh)
        return false;

    int ox = int(a1 & 0x1FFu);
    if (ox >= 256)
        ox -= 512;
    int bloqueIni = int(bloqueX0);
    int bloqueFin = min(bloqueIni + 64, 256);
    return ox < bloqueFin && ox + int(bw) > bloqueIni;
}

uint evaluarObjPixel(uint eng, uint linea, uint x)
{
    uint dispcnt = reg(eng, linea, 0u);
    bool objVentana = false;
    if ((dispcnt & 0x8000u) != 0u && (dispcnt & 0x1000u) != 0u)
    {
        uint oamBaseW = kAtlasOAM + eng * 0x400u;
        uint atlasOW = (eng == 0u) ? kAtlasAOBJ : kAtlasBOBJ;
        uint maskOW = (eng == 0u) ? 0x3FFFFu : 0x1FFFFu;
        bool mapa1DW = (dispcnt & 0x10u) != 0u;
        uint fronteraW = 5u + ((dispcnt >> 20u) & 0x3u);
        for (uint candidato = 0u;
             candidato < objCandidateCount && !objVentana;
             candidato++)
        {
            uint o = objCandidateList[candidato];
            uint a01 = leerU16(oamBaseW + o * 8u);
            if (((a01 >> 10u) & 0x3u) != 2u) continue;
            uint a1 = leerU16(oamBaseW + o * 8u + 2u);
            uint a2 = leerU16(oamBaseW + o * 8u + 4u);
            bool afinW = (a01 & 0x100u) != 0u;
            if (!afinW && (a01 & 0x200u) != 0u) continue;
            uint forma = (a01 >> 14u) & 0x3u;
            uint tam = (a1 >> 14u) & 0x3u;
            uint wpx = 8u, hpx = 8u;
            if (forma == 0u) { wpx = 8u << tam; hpx = wpx; }
            else if (forma == 1u) {
                wpx = (tam == 0u) ? 16u : (tam == 1u) ? 32u : (tam == 2u) ? 32u : 64u;
                hpx = (tam == 0u) ? 8u  : (tam == 1u) ? 8u  : (tam == 2u) ? 16u : 32u;
            } else {
                hpx = (tam == 0u) ? 16u : (tam == 1u) ? 32u : (tam == 2u) ? 32u : 64u;
                wpx = (tam == 0u) ? 8u  : (tam == 1u) ? 8u  : (tam == 2u) ? 16u : 32u;
            }
            uint bw = wpx, bh = hpx;
            if (afinW && (a01 & 0x200u) != 0u) { bw <<= 1u; bh <<= 1u; }
            uint dy = (linea - (a01 & 0xFFu)) & 0xFFu;
            if (dy >= bh) continue;
            int ox = int(a1 & 0x1FFu); if (ox >= 256) ox -= 512;
            int dxi = int(x) - ox;
            if (dxi < 0 || dxi >= int(bw)) continue;
            uint dx = uint(dxi);
            if (afinW)
            {
                uint grupo = (a1 >> 9u) & 0x1Fu;
                uint pbase = oamBaseW + (grupo * 16u + 3u) * 2u;
                int pA = int(leerU16(pbase) << 16) >> 16;
                int pB = int(leerU16(pbase + 8u) << 16) >> 16;
                int pC = int(leerU16(pbase + 16u) << 16) >> 16;
                int pD = int(leerU16(pbase + 24u) << 16) >> 16;
                int cx = int(bw >> 1u); int cy = int(bh >> 1u);
                int rX = (dxi - cx) * pA + (int(dy) - cy) * pB + int(wpx << 7u);
                int rY = (dxi - cx) * pC + (int(dy) - cy) * pD + int(hpx << 7u);
                if (uint(rX) >= (wpx << 8u) || uint(rY) >= (hpx << 8u)) continue;
                dx = uint(rX) >> 8u; dy = uint(rY) >> 8u;
            }
            else
            {
                if ((a1 & 0x1000u) != 0u) dx = wpx - 1u - dx;
                if ((a1 & 0x2000u) != 0u) dy = hpx - 1u - dy;
            }
            uint tileW = a2 & 0x3FFu;
            bool bpp8W = (a01 & 0x2000u) != 0u;
            uint dirW; uint idxW;
            if (bpp8W)
            {
                if (mapa1DW)
                    dirW = (tileW << fronteraW) + (dy >> 3u) * (wpx << 3u) + ((dy & 7u) << 3u) + (dx >> 3u) * 64u + (dx & 7u);
                else
                    dirW = ((tileW & 0x3FEu) << 5u) + (dy >> 3u) * 1024u + ((dy & 7u) << 3u) + (dx >> 3u) * 64u + (dx & 7u);
                idxW = leerByte(atlasOW + (dirW & maskOW));
            }
            else
            {
                if (mapa1DW)
                    dirW = (tileW << fronteraW) + (dy >> 3u) * (wpx << 2u) + ((dy & 7u) << 2u) + (dx >> 3u) * 32u + ((dx & 7u) >> 1u);
                else
                    dirW = (tileW << 5u) + (dy >> 3u) * 1024u + ((dy & 7u) << 2u) + (dx >> 3u) * 32u + ((dx & 7u) >> 1u);
                uint b8W = leerByte(atlasOW + (dirW & maskOW));
                idxW = ((dx & 1u) != 0u) ? (b8W >> 4u) : (b8W & 0xFu);
            }
            if (idxW != 0u) objVentana = true;
        }
    }

    bool objHay = false; uint objPrio = 3u; ivec3 objColor = ivec3(0);
    bool objSemi = false; bool objBitmap = false; uint objAlpha = 0u;
    bool objCaptura = false;
    if ((dispcnt & 0x1000u) != 0u)
    {
        uint oamBase = kAtlasOAM + eng * 0x400u;
        uint atlasOBJ = (eng == 0u) ? kAtlasAOBJ : kAtlasBOBJ;
        uint maskOBJ = (eng == 0u) ? 0x3FFFFu : 0x1FFFFu;
        uint palOBJ = kAtlasPalette + eng * 0x400u + 0x200u;
        uint extPalOBJ = (eng == 0u) ? kAtlasAOBJExtPal : kAtlasBOBJExtPal;
        bool mapa1D = (dispcnt & 0x10u) != 0u;
        uint frontera = 5u + ((dispcnt >> 20u) & 0x3u);
        for (uint candidato = 0u;
             candidato < objCandidateCount && !objHay;
             candidato++)
        {
            uint o = objCandidateList[candidato];
            uint a01 = leerU16(oamBase + o * 8u);
            uint a1 = leerU16(oamBase + o * 8u + 2u);
            uint a2 = leerU16(oamBase + o * 8u + 4u);
            uint modoObj = (a01 >> 10u) & 0x3u;
            bool afin = (a01 & 0x100u) != 0u;
            if (!afin && (a01 & 0x200u) != 0u) continue;
            if (modoObj == 2u) continue;
            if (afin && (a01 & 0x1000u) != 0u) continue;
            uint forma = (a01 >> 14u) & 0x3u;
            uint tam = (a1 >> 14u) & 0x3u;
            uint wpx = 8u, hpx = 8u;
            if (forma == 0u) { wpx = 8u << tam; hpx = wpx; }
            else if (forma == 1u) {
                wpx = (tam == 0u) ? 16u : (tam == 1u) ? 32u : (tam == 2u) ? 32u : 64u;
                hpx = (tam == 0u) ? 8u  : (tam == 1u) ? 8u  : (tam == 2u) ? 16u : 32u;
            } else {
                hpx = (tam == 0u) ? 16u : (tam == 1u) ? 32u : (tam == 2u) ? 32u : 64u;
                wpx = (tam == 0u) ? 8u  : (tam == 1u) ? 8u  : (tam == 2u) ? 16u : 32u;
            }
            uint bw = wpx; uint bh = hpx;
            if (afin && (a01 & 0x200u) != 0u) { bw <<= 1u; bh <<= 1u; }
            uint oy = a01 & 0xFFu;
            uint dy = (linea - oy) & 0xFFu;
            if (dy >= bh) continue;
            int ox = int(a1 & 0x1FFu); if (ox >= 256) ox -= 512;
            int dxi = int(x) - ox;
            if (dxi < 0 || dxi >= int(bw)) continue;
            uint dx = uint(dxi);
            if (afin)
            {

                uint grupo = (a1 >> 9u) & 0x1Fu;
                uint pbase = oamBase + (grupo * 16u + 3u) * 2u;
                int pA = int(leerU16(pbase) << 16) >> 16;
                int pB = int(leerU16(pbase + 8u) << 16) >> 16;
                int pC = int(leerU16(pbase + 16u) << 16) >> 16;
                int pD = int(leerU16(pbase + 24u) << 16) >> 16;
                int cx = int(bw >> 1u); int cy = int(bh >> 1u);
                int rX = (dxi - cx) * pA + (int(dy) - cy) * pB + int(wpx << 7u);
                int rY = (dxi - cx) * pC + (int(dy) - cy) * pD + int(hpx << 7u);
                if (uint(rX) >= (wpx << 8u) || uint(rY) >= (hpx << 8u)) continue;
                dx = uint(rX) >> 8u;
                dy = uint(rY) >> 8u;
            }
            else
            {
                if ((a1 & 0x1000u) != 0u) dx = wpx - 1u - dx;
                if ((a1 & 0x2000u) != 0u) dy = hpx - 1u - dy;
            }
            uint tile = a2 & 0x3FFu;
            uint prio = (a2 >> 10u) & 0x3u;
            bool bpp8 = (a01 & 0x2000u) != 0u;
            if (modoObj == 3u)
            {
                uint alfa = (a2 >> 12u) & 0xFu;
                if (alfa == 0u) continue;
                uint dir3; uint paso;
                if ((dispcnt & 0x40u) != 0u)
                {
                    if ((dispcnt & 0x20u) != 0u) continue;
                    dir3 = tile << (7u + ((dispcnt >> 22u) & 0x1u));
                    paso = wpx * 2u;
                }
                else if ((dispcnt & 0x20u) != 0u)
                {
                    dir3 = ((tile & 0x1Fu) << 4u) + ((tile & 0x3E0u) << 7u);
                    paso = 512u;
                }
                else
                {
                    dir3 = ((tile & 0x0Fu) << 4u) + ((tile & 0x3F0u) << 7u);
                    paso = 256u;
                }
                uint dirObj = (dir3 + dy * paso + dx * 2u) & maskOBJ;
                uint c16o = leerU16(atlasOBJ + dirObj);
                if ((c16o & 0x8000u) == 0u) continue;
                objColor = c555a666(c16o);
                objPrio = prio; objHay = true;
                objBitmap = true; objSemi = false; objAlpha = alfa + 1u;

                if (eng == 1u)
                {
                    uint capIniO = regs[2u * 192u * 32u + 7u];
                    if (capIniO != 0xFFFFFFFFu
                        && dirObj == (((capIniO & 0x3FFFFFFFu)
                                       + (linea * 256u + x) * 2u)
                                      & maskOBJ))
                        objCaptura = true;
                }
                continue;
            }
            uint dir;
            if (bpp8)
            {
                if (mapa1D)
                    dir = (tile << frontera) + (dy >> 3u) * (wpx << 3u) + ((dy & 7u) << 3u) + (dx >> 3u) * 64u + (dx & 7u);
                else
                    dir = ((tile & 0x3FEu) << 5u) + (dy >> 3u) * 1024u + ((dy & 7u) << 3u) + (dx >> 3u) * 64u + (dx & 7u);
                uint idx = leerByte(atlasOBJ + (dir & maskOBJ));
                if (idx == 0u) continue;
                uint off = ((dispcnt & 0x80000000u) != 0u)
                    ? extPalOBJ + ((a2 >> 12u) * 0x200u) + idx * 2u
                    : palOBJ + idx * 2u;
                objColor = c555a666(leerU16(off));
            }
            else
            {
                if (mapa1D)
                    dir = (tile << frontera) + (dy >> 3u) * (wpx << 2u) + ((dy & 7u) << 2u) + (dx >> 3u) * 32u + ((dx & 7u) >> 1u);
                else
                    dir = (tile << 5u) + (dy >> 3u) * 1024u + ((dy & 7u) << 2u) + (dx >> 3u) * 32u + ((dx & 7u) >> 1u);
                uint b8 = leerByte(atlasOBJ + (dir & maskOBJ));
                uint idx = ((dx & 1u) != 0u) ? (b8 >> 4u) : (b8 & 0xFu);
                if (idx == 0u) continue;
                objColor = c555a666(leerU16(palOBJ + ((a2 >> 12u) * 16u + idx) * 2u));
            }
            objPrio = prio; objHay = true;
            objSemi = (modoObj == 1u); objBitmap = false;
        }
    }

    uint paquete = uint(objColor.r & 0x3F) | (uint(objColor.g & 0x3F) << 6u)
                 | (uint(objColor.b & 0x3F) << 12u) | (objPrio << 18u);
    if (objCaptura) paquete |= (1u << 29u);
    if (objHay) paquete |= (1u << 20u);
    if (objSemi) paquete |= (1u << 21u);
    if (objBitmap) paquete |= (1u << 22u);
    paquete |= (objAlpha & 0x1Fu) << 23u;
    if (objVentana) paquete |= (1u << 28u);
    return paquete;
}

vec4 leeCap(uint par, ivec2 p)
{
    return (par != 0u) ? imageLoad(imgCapHighres1, p)
                       : imageLoad(imgCapHighres, p);
}

vec4 lee3d(ivec2 p)
{
    if ((pc.escala & 0x2000u) != 0u)
        return texelFetch(tex3dEscala, p, 0);
    return imageLoad(img3dEscala, p);
}

void leer3dEscala(uint xs, uint fi, uint ratio3d, out uint a5, out ivec3 c3)
{

    if (outputMode() == 4u && (pc.mezcla & 0x80000000u) != 0u
        && ratio3d > 1u)
    {
        uint sampleOffset = ratio3d / 2u;
        vec4 t3 = lee3d(ivec2(int(xs * ratio3d + sampleOffset),
                              int(fi * ratio3d + sampleOffset)));
        uint a83 = uint(t3.a * 255.0 + 0.5);
        a5 = a83 >> 3u;
        c3 = ivec3(int(uint(t3.r * 255.0 + 0.5) >> 2u),
                   int(uint(t3.g * 255.0 + 0.5) >> 2u),
                   int(uint(t3.b * 255.0 + 0.5) >> 2u));
        return;
    }
    if (ratio3d <= 1u || (pc.escala & 0x1000u) == 0u)
    {
        vec4 t3 = lee3d(ivec2(int(xs * ratio3d), int(fi * ratio3d)));
        uint a83 = uint(t3.a * 255.0 + 0.5);
        a5 = a83 >> 3u;
        c3 = ivec3(int(uint(t3.r * 255.0 + 0.5) >> 2u),
                   int(uint(t3.g * 255.0 + 0.5) >> 2u),
                   int(uint(t3.b * 255.0 + 0.5) >> 2u));
        return;
    }
    uint sumA = 0u;
    uvec3 sumC = uvec3(0u);
    for (uint j = 0u; j < ratio3d; j++)
        for (uint i = 0u; i < ratio3d; i++)
        {
            vec4 t3 = lee3d(ivec2(int(xs * ratio3d + i), int(fi * ratio3d + j)));
            uint a8 = uint(t3.a * 255.0 + 0.5);
            sumA += a8;
            sumC += uvec3(uint(t3.r * 255.0 + 0.5),
                          uint(t3.g * 255.0 + 0.5),
                          uint(t3.b * 255.0 + 0.5)) * a8;
        }
    uint n = ratio3d * ratio3d;
    a5 = ((sumA + n / 2u) / n) >> 3u;
    if (sumA == 0u) { c3 = ivec3(0); return; }
    uvec3 c8 = (sumC + uvec3(sumA / 2u)) / sumA;
    c3 = ivec3(int(c8.r >> 2u), int(c8.g >> 2u), int(c8.b >> 2u));
}

bool leer3dCausal(ivec2 base, uint ratio3d, ivec2 dimensions,
                  out uint a5, out ivec3 c3)
{
    a5 = 0u;
    c3 = ivec3(0);
    if (ratio3d == 0u
        || dimensions.x <= 0 || dimensions.y <= 0
        || any(notEqual(textureSize(tex3dCausal, 0), dimensions))
        || base.x < 0 || base.y < 0
        || base.x + int(ratio3d) > dimensions.x
        || base.y + int(ratio3d) > dimensions.y)
    {
        return false;
    }

    if (ratio3d <= 1u || (pc.escala & 0x1000u) == 0u)
    {
        vec4 t3 = texelFetch(tex3dCausal, base, 0);
        uint a83 = uint(t3.a * 255.0 + 0.5);
        a5 = a83 >> 3u;
        c3 = ivec3(int(uint(t3.r * 255.0 + 0.5) >> 2u),
                   int(uint(t3.g * 255.0 + 0.5) >> 2u),
                   int(uint(t3.b * 255.0 + 0.5) >> 2u));
        return true;
    }

    uint sumA = 0u;
    uvec3 sumC = uvec3(0u);
    for (uint j = 0u; j < ratio3d; j++)
        for (uint i = 0u; i < ratio3d; i++)
        {
            vec4 t3 = texelFetch(
                tex3dCausal, base + ivec2(int(i), int(j)), 0);
            uint a8 = uint(t3.a * 255.0 + 0.5);
            sumA += a8;
            sumC += uvec3(uint(t3.r * 255.0 + 0.5),
                          uint(t3.g * 255.0 + 0.5),
                          uint(t3.b * 255.0 + 0.5)) * a8;
        }
    uint n = ratio3d * ratio3d;
    a5 = ((sumA + n / 2u) / n) >> 3u;
    if (sumA == 0u)
        return true;
    uvec3 c8 = (sumC + uvec3(sumA / 2u)) / sumA;
    c3 = ivec3(int(c8.r >> 2u), int(c8.g >> 2u), int(c8.b >> 2u));
    return true;
}

uint recipeBlend4(uint val1, uint val2, uint eva, uint evb)
{
    uint r = (((val1 & 0x00003Fu) * eva)
            + ((val2 & 0x00003Fu) * evb) + 0x000008u) >> 4u;
    uint g = ((((val1 & 0x003F00u) * eva)
            + ((val2 & 0x003F00u) * evb) + 0x000800u) >> 4u)
            & 0x007F00u;
    uint b = ((((val1 & 0x3F0000u) * eva)
            + ((val2 & 0x3F0000u) * evb) + 0x080000u) >> 4u)
            & 0x7F0000u;
    return min(r, 0x3Fu) | min(g, 0x3F00u) | min(b, 0x3F0000u)
        | 0xFF000000u;
}

uint recipeBlend5(uint val1, uint val2)
{
    uint eva = ((val1 >> 24u) & 0x1Fu) + 1u;
    uint evb = 32u - eva;
    if (eva == 32u)
        return val1;
    uint r = (((val1 & 0x00003Fu) * eva)
            + ((val2 & 0x00003Fu) * evb) + 0x000010u) >> 5u;
    uint g = ((((val1 & 0x003F00u) * eva)
            + ((val2 & 0x003F00u) * evb) + 0x001000u) >> 5u)
            & 0x007F00u;
    uint b = ((((val1 & 0x3F0000u) * eva)
            + ((val2 & 0x3F0000u) * evb) + 0x100000u) >> 5u)
            & 0x7F0000u;
    return min(r, 0x3Fu) | min(g, 0x3F00u) | min(b, 0x3F0000u)
        | 0xFF000000u;
}

uint recipeBrightnessUp(uint val, uint factor, uint bias)
{
    uint rb = val & 0x3F003Fu;
    uint g = val & 0x003F00u;
    rb += (((0x3F003Fu - rb) * factor + bias * 0x010001u) >> 4u)
        & 0x3F003Fu;
    g += (((0x003F00u - g) * factor + bias * 0x000100u) >> 4u)
        & 0x003F00u;
    return rb | g | 0xFF000000u;
}

uint recipeBrightnessDown(uint val, uint factor, uint bias)
{
    uint rb = val & 0x3F003Fu;
    uint g = val & 0x003F00u;
    rb -= (((rb * factor + bias * 0x010001u) >> 4u) & 0x3F003Fu);
    g -= (((g * factor + bias * 0x000100u) >> 4u) & 0x003F00u);
    return rb | g | 0xFF000000u;
}

uint resolveCaptureRecipe(uvec4 recipe, uint sourceAKind, uint d3d)
{
    if (sourceAKind == 2u)
        return d3d;
    if (sourceAKind != 1u)
        return recipe.x;

    uint comp = (recipe.z >> 24u) & 0xFu;
    bool has3d = (d3d >> 24u) != 0u;
    if (comp == 4u)
        return has3d ? recipeBlend5(d3d, recipe.x) : recipe.y;
    if (comp == 1u)
        return has3d
            ? recipeBlend4(recipe.x, d3d,
                (recipe.z >> 8u) & 0x1Fu,
                (recipe.z >> 16u) & 0x1Fu)
            : recipe.y;
    if (comp <= 3u)
    {
        if (!has3d)
            return recipe.y;
        if (comp == 2u)
            return recipeBrightnessUp(d3d,
                (recipe.z >> 8u) & 0x1Fu, 0x8u);
        if (comp == 3u)
            return recipeBrightnessDown(d3d,
                (recipe.z >> 8u) & 0x1Fu, 0x7u);
        return d3d;
    }
    return recipe.x;
}

uint recipePackRgb555(uint val)
{
    return ((val >> 1u) & 0x1Fu)
        | (((val >> 9u) & 0x1Fu) << 5u)
        | (((val >> 17u) & 0x1Fu) << 10u)
        | ((val >> 24u) != 0u ? 0x8000u : 0u);
}

vec4 recipeImageColor(uint val)
{
    uint packed = recipePackRgb555(val);
    uint r6 = (packed & 0x1Fu) << 1u;
    uint g6 = ((packed >> 5u) & 0x1Fu) << 1u;
    uint b6 = ((packed >> 10u) & 0x1Fu) << 1u;
    return vec4(float(a8(int(b6))) / 255.0,
                float(a8(int(g6))) / 255.0,
                float(a8(int(r6))) / 255.0,
                (packed & 0x8000u) != 0u ? 1.0 : 0.0);
}

vec4 recipeImageColorPacked(uint packed)
{
    uint r6 = (packed & 0x1Fu) << 1u;
    uint g6 = ((packed >> 5u) & 0x1Fu) << 1u;
    uint b6 = ((packed >> 10u) & 0x1Fu) << 1u;
    return vec4(float(a8(int(b6))) / 255.0,
                float(a8(int(g6))) / 255.0,
                float(a8(int(r6))) / 255.0,
                (packed & 0x8000u) != 0u ? 1.0 : 0.0);
}

uint h5ImagePackRgb555(vec4 color)
{
    vec4 clamped = clamp(color, vec4(0.0), vec4(1.0));
    uint b8 = uint(clamped.r * 255.0 + 0.5);
    uint g8 = uint(clamped.g * 255.0 + 0.5);
    uint r8 = uint(clamped.b * 255.0 + 0.5);
    return (r8 >> 3u) | ((g8 >> 3u) << 5u)
        | ((b8 >> 3u) << 10u)
        | (clamped.a >= 0.5 ? 0x8000u : 0u);
}

uint captureBlendRgb555(uint sourceA, uint sourceB, uint eva, uint evb)
{
    eva = min(eva, 16u);
    evb = min(evb, 16u);
    uint alphaA = sourceA >> 15u;
    uint alphaB = sourceB >> 15u;
    uint r = ((((sourceA & 0x1Fu) * alphaA * eva)
             + ((sourceB & 0x1Fu) * alphaB * evb) + 8u) >> 4u);
    uint g = (((((sourceA >> 5u) & 0x1Fu) * alphaA * eva)
             + (((sourceB >> 5u) & 0x1Fu) * alphaB * evb) + 8u) >> 4u);
    uint b = (((((sourceA >> 10u) & 0x1Fu) * alphaA * eva)
             + (((sourceB >> 10u) & 0x1Fu) * alphaB * evb) + 8u) >> 4u);
    uint alpha = ((eva > 0u ? alphaA : 0u)
                | (evb > 0u ? alphaB : 0u)) << 15u;
    return min(r, 0x1Fu) | (min(g, 0x1Fu) << 5u)
        | (min(b, 0x1Fu) << 10u) | alpha;
}

bool sampleCaptureRecipeSourceB(uint outputX, uint outputY,
                                uint outputScale, bool nativeCenter,
                                uvec4 recipeB, uvec4 recipeC,
                                out uint packed)
{
    packed = recipeC.y & 0xFFFFu;
    uint kind = (recipeC.y >> 16u) & 0xFFu;
    bool exact = (recipeC.y & (1u << 24u)) != 0u;
    if (!exact)
        return false;
    if (kind == 0u)
    {
        packed = 0u;
        return true;
    }
    if (kind == 1u)
        return true;
    if (kind != 2u || recipeC.z == 0u || recipeC.z > 4u)
        return false;
    uint slot = recipeC.z - 1u;
    if (!h5SlotCertificada(
            slot, recipeB.x, recipeB.y, recipeB.z, recipeB.w))
        return false;
    uint sourceX = recipeC.x & 0xFFFFu;
    uint sourceY = recipeC.x >> 16u;
    if (sourceX >= 256u || sourceY >= 192u || outputScale == 0u)
        return false;
    uint subX = nativeCenter ? outputScale / 2u
        : outputX % outputScale;
    uint subY = nativeCenter ? outputScale / 2u
        : outputY % outputScale;
    ivec2 source = ivec2(int(sourceX * outputScale + subX),
                         int(sourceY * outputScale + subY));
    packed = h5ImagePackRgb555(h5LeeSlot(slot, source));
    return true;
}

uint resolveCaptureProductPacked(uvec4 recipeA, uint sourceAKind,
                                 uint d3d, uint sourceB,
                                 uint captureParameters)
{
    uint captureMode = captureParameters & 0xFFu;
    uint eva = (captureParameters >> 8u) & 0xFFu;
    uint evb = (captureParameters >> 16u) & 0xFFu;
    uint sourceA = recipePackRgb555(
        resolveCaptureRecipe(recipeA, sourceAKind, d3d));
    if (captureMode == 0u)
        return sourceA;
    if (captureMode == 1u)
        return sourceB;
    return captureBlendRgb555(sourceA, sourceB, eva, evb);
}

uint packCaptureLineExport(vec4 color)
{
    vec4 clamped = clamp(color, vec4(0.0), vec4(1.0));
    uint r8 = uint(clamped.r * 255.0 + 0.5);
    uint g8 = uint(clamped.g * 255.0 + 0.5);
    uint b8 = uint(clamped.b * 255.0 + 0.5);
    uint a8v = uint(clamped.a * 255.0 + 0.5);
    return (r8 >> 2u) | ((g8 >> 2u) << 8u)
        | ((b8 >> 2u) << 16u) | ((a8v >> 3u) << 24u);
}

bool sampleCaptureRecipe3d(uint outputX, uint outputY, uint outputScale,
                           uvec4 route, bool nativeCenter, out uint d3d)
{
    d3d = 0u;
    if ((route.x & (1u << 22u)) == 0u)
        return true;
    uint rawX = route.y & 0x1FFu;
    int signedX = rawX >= 0x100u ? int(rawX) - 0x200 : int(rawX);
    uint sourceY = route.y >> 16u;
    uint nativeX = outputX / outputScale;
    uint nativeY = outputY / outputScale;
    int sourceNativeX = int(nativeX) + signedX;
    if (sourceNativeX < 0 || sourceNativeX >= 256 || sourceY >= 192u)
        return true;

    ivec2 dimensions = textureSize(tex3dEscala, 0);
    if (dimensions.x <= 0 || dimensions.y <= 0
        || (dimensions.x % 256) != 0 || (dimensions.y % 192) != 0)
        return false;
    uint ratioX = uint(dimensions.x) / 256u;
    uint ratioY = uint(dimensions.y) / 192u;
    if (ratioX == 0u || ratioX != ratioY)
        return false;

    uint subX = nativeCenter ? ratioX / 2u
        : ((outputX % outputScale) * ratioX) / outputScale;
    uint subY = nativeCenter ? ratioY / 2u
        : ((outputY % outputScale) * ratioY) / outputScale;
    ivec2 source = ivec2(sourceNativeX * int(ratioX) + int(subX),
                         int(sourceY * ratioY + subY));
    if (any(lessThan(source, ivec2(0)))
        || any(greaterThanEqual(source, dimensions)))
        return false;
    d3d = packCaptureLineExport(texelFetch(tex3dEscala, source, 0));
    return true;
}

bool sampleCaptureRecipeNativeProjection(
    uint outputX, uint outputY, uvec4 route, out uint d3d)
{
    d3d = 0u;
    if ((route.x & (1u << 22u)) == 0u)
        return true;
    uint rawX = route.y & 0x1FFu;
    int signedX = rawX >= 0x100u ? int(rawX) - 0x200 : int(rawX);
    uint sourceY = route.y >> 16u;
    int sourceX = int(outputX) + signedX;
    if (sourceX < 0 || sourceX >= 256 || sourceY >= 192u)
        return true;
    d3d = nativeProjection[sourceY * 256u + uint(sourceX)];
    return true;
}

uint causalBuildLiveLineDescriptor(uint physicalScreen, uint physicalLine,
                                   uint outputScale, uint expectedRatio,
                                   bool visibleAllNative)
{
    uvec4 routeLive;
    uvec4 lineRenderKey;
    bool routeLoaded = causalLoadRouteLive(
        physicalScreen, physicalLine, routeLive, lineRenderKey);
    uint engine = (routeLive.x >> 8u) & 0xFFu;
    bool routeExact = routeLoaded
        && (routeLive.x & 0xFFu) == 0x03u
        && engine < 2u
        && ((routeLive.x >> 16u) & 0xFFu) == physicalScreen;
    uint descriptor = routeExact
        ? ((1u << 31u) | (engine << 30u)) : 0u;

    uvec4 boundRenderKey;
    uvec4 boundMetadata;
    if (!routeExact || engine != 0u
        || !causalLoadBoundLive(boundRenderKey, boundMetadata))
        return descriptor;

    uint liveFlags = routeLive.y;
    bool liveDirect = (liveFlags & 0x0Fu) == 0x0Fu
        && (liveFlags & 0x10u) == 0u
        && ((liveFlags >> 8u) & 0xFFu) == 0u
        && ((liveFlags >> 16u) & 0xFFu) == physicalScreen;
    bool exactKey = all(equal(lineRenderKey, boundRenderKey));
    uint width = boundMetadata.y & 0xFFFFu;
    uint height = boundMetadata.y >> 16u;
    uint renderScale = width / 256u;
    bool validDimensions = width >= 256u * outputScale
        && (width % 256u) == 0u
        && renderScale >= outputScale
        && (renderScale % outputScale) == 0u
        && height == 192u * renderScale;
    int sourceXBase = int(routeLive.w & 0xFFFFu);
    if ((sourceXBase & 0x8000) != 0)
        sourceXBase -= 0x10000;
    uint sourceY = routeLive.w >> 16u;
    uint renderRatio = validDimensions ? renderScale / outputScale : 0u;
    bool validBoundImage = validDimensions
        && all(equal(textureSize(tex3dCausal, 0),
                     ivec2(int(width), int(height))));
    bool validCoordinates = sourceXBase >= -256 && sourceXBase <= 255
        && sourceY < 192u && renderRatio >= 1u && renderRatio <= 0xFFu
        && renderRatio == expectedRatio;
    if (liveDirect && exactKey && validBoundImage && validCoordinates)
    {
        descriptor |= (1u << 29u)
            | (visibleAllNative ? (1u << 28u) : 0u)
            | (uint(sourceXBase) & 0x1FFu)
            | (sourceY << 9u)
            | (renderRatio << 17u);
    }
    return descriptor;
}

const uint kB1Blend2dOver3d = 1u << 22u;
const uint kB1Needs3d = (1u << 18u) | kB1Blend2dOver3d;
const uint kB1Precomposed3d = 1u << 23u;

ivec3 composePrecomposed3d(uint operand, ivec3 color3d, uint alpha3d)
{
    ivec3 color2d = ivec3(int(operand & 0x3Fu),
        int((operand >> 6u) & 0x3Fu), int((operand >> 12u) & 0x3Fu));
    uint mode = (operand >> 28u) & 7u;
    int eva = int((operand >> 18u) & 0x1Fu);
    int evb = int((operand >> 23u) & 0x1Fu);
    if (mode == 5u)
    {
        int alpha = int(alpha3d + 1u);
        return min(ivec3(63),
            (color3d * alpha + color2d * (32 - alpha) + 16) >> 5);
    }
    if (mode == 2u)
        return min(ivec3(63), (color2d * eva + color3d * evb + 8) >> 4);
    if (mode == 3u)
        return color3d + (((ivec3(63) - color3d) * eva + 8) >> 4);
    if (mode == 4u)
        return color3d - ((color3d * eva + 7) >> 4);
    return color3d;
}


ivec3 blend2dOver3d(uint foreground, ivec3 background)
{
    ivec3 top = ivec3(int(foreground & 0x3Fu),
        int((foreground >> 6u) & 0x3Fu),
        int((foreground >> 12u) & 0x3Fu));
    int eva = int((foreground >> 18u) & 0x1Fu);
    int evb = int((foreground >> 23u) & 0x1Fu);
    return min(ivec3(63), (top * eva + background * evb + 8) >> 4);
}

struct FinalCellState
{
    uint nativeX;
    uint line;
    uint descriptor;
    uint w0;
    uint w1;
    uint displayMode;
    uint row3d;
    int brightnessMode;
    int brightnessFactor;
    uint forceBlank;
};

FinalCellState makeFinalCellState(
    uint nativeX, uint line, uint descriptor, uint w0, uint w1,
    uint displayMode, uint row3d, int brightnessMode,
    int brightnessFactor, bool forceBlank)
{
    FinalCellState state;
    state.nativeX = nativeX;
    state.line = line;
    state.descriptor = descriptor;
    state.w0 = w0;
    state.w1 = w1;
    state.displayMode = displayMode;
    state.row3d = row3d;
    state.brightnessMode = brightnessMode;
    state.brightnessFactor = brightnessFactor;
    state.forceBlank = forceBlank ? 1u : 0u;
    return state;
}

FinalCellState loadFinalCellState(
    uint nativeX, uint line, uint engine, uint descriptor)
{
    uint dispcnt = reg(engine, line, 0u);
    uint w18 = reg(engine, line, 18u);
    uint w22 = reg(engine, line, 22u);
    uint masterBrightness = (w22 >> 16u) & 0xFFFFu;
    int brightnessMode = int((masterBrightness >> 14u) & 0x3u);
    int brightnessFactor = min(16, int(masterBrightness & 0x1Fu));
    uint index = ((engine * 192u + line) * 256u + nativeX) * 2u;
    uint row3d = reg(engine, line, 26u);
    if (row3d > 191u)
        row3d = line;
    return makeFinalCellState(
        nativeX, line, descriptor, fielB1[index], fielB1[index + 1u],
        (dispcnt >> 16u) & 0x3u, row3d,
        brightnessMode, brightnessFactor, (w18 & 0x100u) != 0u);
}

void storeFinalSubpixel(
    FinalCellState state, uint outputScale, uint subX, uint subY,
    uint outputX, uint outputY)
{
    uint w0 = state.w0;
    uint w1 = state.w1;
    uint descriptorCompacto = state.descriptor;
    bool forceblank = state.forceBlank != 0u;
    ivec3 baseB1 = ivec3(int(w0 & 0x3Fu), int((w0 >> 6u) & 0x3Fu),
                         int((w0 >> 12u) & 0x3Fu));
    ivec3 colorF = baseB1;
    bool brilloB2 = true;
    uint carrilSonda = 0u;
    bool capa3dResuelta = false;
    uint a5Resuelto = 0u;
    ivec3 c3Resuelto = ivec3(0);
    if ((w0 & (1u << 20u)) != 0u)
    {
        uint sourceX = w1 & 0xFFu;
        uint sourceY = (w1 >> 8u) & 0xFFu;
        uint slot = (w1 >> 16u) & 0x3u;
        uint postEffect = (w1 >> 18u) & 0x3u;
        int causalEvy = min(16, int((w1 >> 20u) & 0x1Fu));
        ivec2 pCap = ivec2(
            int(sourceX * outputScale + subX),
            int(sourceY * outputScale + subY));
        vec4 tcap = h5LeeSlot(slot, pCap);
        colorF = ivec3(
            int(uint(tcap.b * 255.0 + 0.5) >> 2u),
            int(uint(tcap.g * 255.0 + 0.5) >> 2u),
            int(uint(tcap.r * 255.0 + 0.5) >> 2u));
        aplicaPostEffectCausal(colorF, postEffect, causalEvy);
        brilloB2 = false;
        capa3dResuelta = true;
        carrilSonda = 1u;
    }
    if (!capa3dResuelta
        && ((w0 & (1u << 21u)) != 0u
            || (descriptorCompacto & (1u << 28u)) != 0u)
        && (descriptorCompacto & (1u << 29u)) != 0u
        && (w0 & kB1Needs3d) != 0u)
    {
        int sourceXBase = int(descriptorCompacto & 0x1FFu);
        if ((sourceXBase & 0x100) != 0)
            sourceXBase -= 0x200;
        int sourceY = int((descriptorCompacto >> 9u) & 0xFFu);
        uint causalRatio = (descriptorCompacto >> 17u) & 0xFFu;
        ivec2 sampleBase = ivec2(
            (sourceXBase * int(outputScale) + int(outputX))
                * int(causalRatio),
            (sourceY * int(outputScale) + int(subY))
                * int(causalRatio));
        bool liveHighresExacto = !forceblank && leer3dCausal(
            sampleBase, causalRatio,
            ivec2(int(256u * outputScale * causalRatio),
                  int(192u * outputScale * causalRatio)),
            a5Resuelto, c3Resuelto);
        capa3dResuelta = liveHighresExacto;
    }
    if (!capa3dResuelta && (w0 & kB1Needs3d) != 0u)
    {
        uint native3d = d3d[state.row3d * 256u + state.nativeX];
        a5Resuelto = ((native3d >> 24u) & 0xFFu) >> 3u;
        c3Resuelto = ivec3(int((native3d & 0xFFu) >> 2u),
                           int(((native3d >> 8u) & 0xFFu) >> 2u),
                           int(((native3d >> 16u) & 0xFFu) >> 2u));
        capa3dResuelta = true;
    }
    if (capa3dResuelta && carrilSonda != 1u)
    {
        carrilSonda = (a5Resuelto != 0u) ? 2u : 3u;
        if (a5Resuelto != 0u)
        {
            if ((w0 & kB1Precomposed3d) != 0u)
                colorF = composePrecomposed3d(w1, c3Resuelto, a5Resuelto);
            else if ((w0 & kB1Blend2dOver3d) != 0u)
                colorF = blend2dOver3d(w1, c3Resuelto);
            else if ((w0 & (1u << 19u)) != 0u && (a5Resuelto + 1u) < 32u)
            {
                ivec3 abajo = ivec3(
                    int(w1 & 0x3Fu), int((w1 >> 6u) & 0x3Fu),
                    int((w1 >> 12u) & 0x3Fu));
                int eva5 = int(a5Resuelto + 1u);
                int evb5 = 32 - eva5;
                colorF = ivec3(
                    min(63, (c3Resuelto.r * eva5
                        + abajo.r * evb5 + 16) >> 5),
                    min(63, (c3Resuelto.g * eva5
                        + abajo.g * evb5 + 16) >> 5),
                    min(63, (c3Resuelto.b * eva5
                        + abajo.b * evb5 + 16) >> 5));
            }
            else
                colorF = c3Resuelto;
        }
    }
    if (!forceblank && state.displayMode != 0u && brilloB2)
    {
        if (state.brightnessMode == 1 && state.brightnessFactor > 0)
        {
            colorF.r = clamp6(colorF.r
                + (((63 - colorF.r) * state.brightnessFactor) >> 4));
            colorF.g = clamp6(colorF.g
                + (((63 - colorF.g) * state.brightnessFactor) >> 4));
            colorF.b = clamp6(colorF.b
                + (((63 - colorF.b) * state.brightnessFactor) >> 4));
        }
        else if (state.brightnessMode == 2 && state.brightnessFactor > 0)
        {
            colorF.r = clamp6(colorF.r
                - (((colorF.r * state.brightnessFactor) + 0xF) >> 4));
            colorF.g = clamp6(colorF.g
                - (((colorF.g * state.brightnessFactor) + 0xF) >> 4));
            colorF.b = clamp6(colorF.b
                - (((colorF.b * state.brightnessFactor) + 0xF) >> 4));
        }
    }
    if (((pc.escala >> 14u) & 3u) == 2u)
        colorF = carrilSonda == 0u ? ivec3(0, 63, 0)
               : carrilSonda == 1u ? ivec3(63, 0, 63)
               : carrilSonda == 2u ? ivec3(63, 0, 0)
               : ivec3(0, 0, 63);
    imageStore(outImage, ivec2(int(outputX), int(outputY)),
        vec4(float(a8(colorF.b)) / 255.0, float(a8(colorF.g)) / 255.0,
             float(a8(colorF.r)) / 255.0, 1.0));
}

void runFinalNativeCell()
{
    uint outputScale = max(pc.escala & 0xFFu, 1u);
    uint subtilesPerAxis =
        (outputScale + kSpecializedFinalNativeSubtileSize - 1u)
        / kSpecializedFinalNativeSubtileSize;
    uint nativeX = gl_GlobalInvocationID.x / subtilesPerAxis;
    uint nativeRow = gl_GlobalInvocationID.y;
    uint subtileX = gl_GlobalInvocationID.x % subtilesPerAxis;
    uint subtileY = gl_GlobalInvocationID.z;
    if (nativeX >= 256u || nativeRow >= 386u || outputScale <= 1u
        || subtileY >= subtilesPerAxis)
        return;

    uint subXBegin = subtileX * kSpecializedFinalNativeSubtileSize;
    uint subYBegin = subtileY * kSpecializedFinalNativeSubtileSize;
    uint subXEnd = min(
        subXBegin + kSpecializedFinalNativeSubtileSize, outputScale);
    uint subYEnd = min(
        subYBegin + kSpecializedFinalNativeSubtileSize, outputScale);
    uint outputYBase = nativeRow * outputScale;
    if (nativeRow >= 192u && nativeRow < 194u)
    {
#define STORE_FINAL_BLACK(DX, DY) \
        if (subXBegin + DX < subXEnd && subYBegin + DY < subYEnd) \
            imageStore(outImage, \
                ivec2(int(nativeX * outputScale + subXBegin + DX), \
                      int(outputYBase + subYBegin + DY)), \
                vec4(0.0, 0.0, 0.0, 1.0));
        if (kSpecializedFinalNativeSubtileSize == 2u)
        {
            STORE_FINAL_BLACK(0u, 0u) STORE_FINAL_BLACK(1u, 0u)
            STORE_FINAL_BLACK(0u, 1u) STORE_FINAL_BLACK(1u, 1u)
        }
        else
        {
            STORE_FINAL_BLACK(0u, 0u) STORE_FINAL_BLACK(1u, 0u)
            STORE_FINAL_BLACK(2u, 0u) STORE_FINAL_BLACK(3u, 0u)
            STORE_FINAL_BLACK(0u, 1u) STORE_FINAL_BLACK(1u, 1u)
            STORE_FINAL_BLACK(2u, 1u) STORE_FINAL_BLACK(3u, 1u)
            STORE_FINAL_BLACK(0u, 2u) STORE_FINAL_BLACK(1u, 2u)
            STORE_FINAL_BLACK(2u, 2u) STORE_FINAL_BLACK(3u, 2u)
            STORE_FINAL_BLACK(0u, 3u) STORE_FINAL_BLACK(1u, 3u)
            STORE_FINAL_BLACK(2u, 3u) STORE_FINAL_BLACK(3u, 3u)
        }
#undef STORE_FINAL_BLACK
        return;
    }

    uint physicalScreen = nativeRow < 192u ? 0u : 1u;
    uint line = nativeRow < 192u ? nativeRow : nativeRow - 194u;
    uint descriptor = objLinea[physicalScreen * 192u + line];
    if ((descriptor & (1u << 31u)) == 0u)
        return;
    uint engine = (descriptor >> 30u) & 1u;
    FinalCellState state = loadFinalCellState(
        nativeX, line, engine, descriptor);
    uint outputXBase = nativeX * outputScale;
#define STORE_FINAL_SUBPIXEL(DX, DY) \
    if (subXBegin + DX < subXEnd && subYBegin + DY < subYEnd) \
        storeFinalSubpixel( \
            state, outputScale, subXBegin + DX, subYBegin + DY, \
            outputXBase + subXBegin + DX, outputYBase + subYBegin + DY);
    if (kSpecializedFinalNativeSubtileSize == 2u)
    {
        STORE_FINAL_SUBPIXEL(0u, 0u) STORE_FINAL_SUBPIXEL(1u, 0u)
        STORE_FINAL_SUBPIXEL(0u, 1u) STORE_FINAL_SUBPIXEL(1u, 1u)
    }
    else
    {
        STORE_FINAL_SUBPIXEL(0u, 0u) STORE_FINAL_SUBPIXEL(1u, 0u)
        STORE_FINAL_SUBPIXEL(2u, 0u) STORE_FINAL_SUBPIXEL(3u, 0u)
        STORE_FINAL_SUBPIXEL(0u, 1u) STORE_FINAL_SUBPIXEL(1u, 1u)
        STORE_FINAL_SUBPIXEL(2u, 1u) STORE_FINAL_SUBPIXEL(3u, 1u)
        STORE_FINAL_SUBPIXEL(0u, 2u) STORE_FINAL_SUBPIXEL(1u, 2u)
        STORE_FINAL_SUBPIXEL(2u, 2u) STORE_FINAL_SUBPIXEL(3u, 2u)
        STORE_FINAL_SUBPIXEL(0u, 3u) STORE_FINAL_SUBPIXEL(1u, 3u)
        STORE_FINAL_SUBPIXEL(2u, 3u) STORE_FINAL_SUBPIXEL(3u, 3u)
    }
#undef STORE_FINAL_SUBPIXEL
}

