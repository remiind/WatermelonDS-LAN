const uint kCausalAbiVersion          = 5u;
const uint kCausalHeaderRoutesValid   = 1u << 0u;
const uint kCausalHeaderFullValid     = 1u << 1u;
const uint kCausalHeaderAllNative     = 1u << 2u;
const uint kCausalHeaderWords         = 16u;
const uint kCausalPhysicalScreens     = 2u;
const uint kCausalScreenWidth         = 256u;
const uint kCausalScreenHeight        = 192u;
const uint kCausalRouteLineCount      = 384u;
const uint kCausalVisiblePixelCount   = 98304u;
const uint kCausalProductCapacity     = 1024u;
const uint kCausalRouteOffsetWords    = 16u;
const uint kCausalLineageRowOffsetWords = 3088u;
const uint kCausalLineageOffsetWords  = 4624u;
const uint kCausalProductOffsetWords  = 397840u;
const uint kCausalBoundLiveOffsetWords = 406032u;
const uint kCausalCaptureRecipeHeaderOffsetWords = 406040u;
const uint kCausalCaptureRecipeLineOffsetWords = 406056u;
const uint kCausalCaptureRecipePixelOffsetWords = 407592u;
const uint kCausalCaptureMaterialOffsetWords = 997416u;
const uint kCausalTotalWords          = 1021992u;

bool causalRouteHeaderValid()
{

    return (causal[0u] & kCausalHeaderRoutesValid) != 0u
        && (causal[0u] & ~(kCausalHeaderRoutesValid
            | kCausalHeaderFullValid
            | kCausalHeaderAllNative)) == 0u
        && causal[1u] == kCausalAbiVersion
        && (causal[2u] | causal[3u]) != 0u
        && (causal[5u] | causal[6u]) != 0u
        && causal[7u] == kCausalRouteLineCount
        && causal[8u] == kCausalVisiblePixelCount
        && causal[9u] == kCausalRouteOffsetWords
        && causal[10u] == kCausalLineageOffsetWords
        && causal[11u] == kCausalProductOffsetWords
        && causal[12u] == kCausalTotalWords;
}

bool causalHeaderValid()
{
    uint productCount = causal[4u];
    bool fullLineage = (causal[0u] & kCausalHeaderFullValid) != 0u;
    bool allNative = (causal[0u] & kCausalHeaderAllNative) != 0u;
    return causalRouteHeaderValid()
        && fullLineage != allNative
        && (fullLineage
            ? productCount >= 2u && productCount <= kCausalProductCapacity
            : productCount == 0u);
}

bool causalLoadRouteLive(uint physicalScreen, uint physicalLine,
                         out uvec4 routeLive, out uvec4 liveRenderKey)
{
    routeLive = uvec4(0u);
    liveRenderKey = uvec4(0u);
    if (!causalRouteHeaderValid()
        || physicalScreen >= kCausalPhysicalScreens
        || physicalLine >= kCausalScreenHeight)
        return false;

    uint lineIndex = physicalScreen * kCausalScreenHeight + physicalLine;
    uint word = kCausalRouteOffsetWords + lineIndex * 8u;
    routeLive = uvec4(causal[word + 0u], causal[word + 1u],
                      causal[word + 2u], causal[word + 3u]);
    liveRenderKey = uvec4(causal[word + 4u], causal[word + 5u],
                          causal[word + 6u], causal[word + 7u]);
    return true;
}

bool causalLoadVisiblePixel(uint physicalScreen, uint physicalLine,
                            uint physicalX, out uvec4 lineage)
{
    lineage = uvec4(0u);
    if (!causalHeaderValid()
        || physicalScreen >= kCausalPhysicalScreens
        || physicalLine >= kCausalScreenHeight
        || physicalX >= kCausalScreenWidth)
        return false;

    if ((causal[0u] & kCausalHeaderAllNative) != 0u)
        return true;

    uint lineIndex = physicalScreen * kCausalScreenHeight + physicalLine;
    uint rowWord = kCausalLineageRowOffsetWords + lineIndex * 4u;
    uint rowKind = causal[rowWord + 0u];
    uint rowOperand = causal[rowWord + 1u];
    uint rowControl = causal[rowWord + 2u];
    uint rowReserved = causal[rowWord + 3u];
    if (rowReserved != 0u)
        return false;
    if (rowKind == 1u)
        return rowOperand == 0u && rowControl == 0u;
    if (rowKind == 2u)
    {
        uint sourceXBase = (rowOperand >> 16u) & 0xFFu;
        uint sourceX = sourceXBase + physicalX;
        if (sourceX > 0xFFu)
            return false;
        lineage = uvec4(
            (rowOperand & 0xFF00FFFFu) | (sourceX << 16u),
            0u, rowControl, 0u);
        return true;
    }
    if (rowKind == 3u)
    {
        lineage = uvec4(1u, 0u, 4u, 0u);
        return true;
    }
    if (rowKind != 4u)
        return false;
    if (rowOperand != 0u || rowControl != 0u)
        return false;

    uint pixel = lineIndex * kCausalScreenWidth + physicalX;
    uint word = kCausalLineageOffsetWords + pixel * 4u;
    lineage = uvec4(causal[word + 0u], causal[word + 1u],
                    causal[word + 2u], causal[word + 3u]);
    return true;
}

bool causalLoadProduct(uint handle, out uvec4 identity,
                       out uvec4 metadata)
{
    identity = uvec4(0u);
    metadata = uvec4(0u);
    if (!causalHeaderValid()
        || (causal[0u] & kCausalHeaderFullValid) == 0u
        || handle >= causal[4u]
        || handle >= kCausalProductCapacity)
        return false;

    uint word = kCausalProductOffsetWords + handle * 8u;
    identity = uvec4(causal[word + 0u], causal[word + 1u],
                     causal[word + 2u], causal[word + 3u]);
    metadata = uvec4(causal[word + 4u], causal[word + 5u],
                     causal[word + 6u], causal[word + 7u]);
    return true;
}

bool causalLoadBoundLive(out uvec4 identity, out uvec4 metadata)
{
    identity = uvec4(0u);
    metadata = uvec4(0u);
    if (!causalHeaderValid())
        return false;

    uint word = kCausalBoundLiveOffsetWords;
    uint valid = causal[word + 0u];
    uint flags = causal[word + 1u];
    identity = uvec4(causal[word + 2u], causal[word + 3u],
                     causal[word + 4u], causal[word + 5u]);
    metadata = uvec4(flags, causal[word + 6u], 0u, 0u);
    return valid == 1u
        && (flags & 1u) != 0u
        && (identity.x | identity.y) != 0u
        && (identity.z | identity.w) != 0u;
}

bool causalCaptureRecipeHeader(out uvec4 productKey,
                               out uvec4 renderKey,
                               out uvec4 metadata)
{
    productKey = uvec4(0u);
    renderKey = uvec4(0u);
    metadata = uvec4(0u);
    uint word = kCausalCaptureRecipeHeaderOffsetWords;
    uint valid = causal[word + 0u];
    uint version = causal[word + 1u];
    productKey = uvec4(causal[word + 2u], causal[word + 3u],
                       causal[word + 4u], causal[word + 5u]);
    uint captureCnt = causal[word + 6u];
    uint dimensions = causal[word + 7u];
    uint lineOffset = causal[word + 8u];
    uint pixelOffset = causal[word + 9u];
    uint lineCount = causal[word + 10u];
    uint flags = causal[word + 11u];
    renderKey = uvec4(causal[word + 12u], causal[word + 13u],
                      causal[word + 14u], causal[word + 15u]);
    metadata = uvec4(captureCnt, dimensions, lineCount, flags);
    bool hasSourceARenderKey = (flags & (1u << 7u)) != 0u;
    bool sourceAOnly = (flags & (1u << 8u)) != 0u;
    bool specializedEncodingValid =
        kSpecializedCaptureRecipeEncoding == 0xFFFFFFFFu
        || (kSpecializedCaptureRecipeEncoding <= 1u
            && sourceAOnly
                == (kSpecializedCaptureRecipeEncoding == 1u));
    bool renderKeyPresent = (renderKey.x | renderKey.y) != 0u
        && (renderKey.z | renderKey.w) != 0u;
    uint captureMode = (captureCnt >> 29u) & 0x3u;
    uint effectiveEva = min(captureCnt & 0x1Fu, 16u);
    uint effectiveEvb = min((captureCnt >> 8u) & 0x1Fu, 16u);
    bool sourceAOnlyFormula = captureMode == 0u
        || (captureMode >= 2u
            && effectiveEva != 0u && effectiveEvb == 0u);
    return valid == 1u
        && ((version == 2u && !sourceAOnly)
            || (version == 3u && sourceAOnly))
        && (productKey.x | productKey.y) != 0u
        && (productKey.z | productKey.w) != 0u
        && dimensions == (256u | (192u << 16u))
        && lineOffset == kCausalCaptureRecipeLineOffsetWords
        && pixelOffset == kCausalCaptureRecipePixelOffsetWords
        && lineCount == 192u

        && (flags & 0x7Fu) == 0x7Fu
        && (flags & ~0x1FFu) == 0u
        && specializedEncodingValid
        && (!sourceAOnly || sourceAOnlyFormula)
        && renderKeyPresent == hasSourceARenderKey;
}

bool causalLoadCaptureRecipeLineValidated(uint line,
                                          uvec4 headerRenderKey,
                                          uvec4 metadata,
                                          out uvec4 route,
                                          out uvec4 renderKey)
{
    route = uvec4(0u);
    renderKey = uvec4(0u);
    if (line >= 192u)
        return false;
    uint word = kCausalCaptureRecipeLineOffsetWords + line * 8u;
    route = uvec4(causal[word + 0u], causal[word + 1u],
                  causal[word + 6u], causal[word + 7u]);
    renderKey = uvec4(causal[word + 2u], causal[word + 3u],
                      causal[word + 4u], causal[word + 5u]);
    bool sourceAUses3d = (route.x & (1u << 22u)) != 0u;
    bool sourceAOnly = (metadata.w & (1u << 8u)) != 0u;
    bool lineKeyPresent = (renderKey.x | renderKey.y) != 0u
        && (renderKey.z | renderKey.w) != 0u;
    uint captureCnt = metadata.x;
    uint expectedCaptureMode = (captureCnt >> 29u) & 0x3u;
    uint expectedEva = min(captureCnt & 0x1Fu, 16u);
    uint expectedEvb = min((captureCnt >> 8u) & 0x1Fu, 16u);
    uint expectedCaptureParameters = expectedCaptureMode
        | (expectedEva << 8u) | (expectedEvb << 16u) | (0xFFu << 24u);
    uint sourceAKind = (route.x >> 8u) & 0xFu;
    const uint sourceAOnlyLineMask = 1u | (0xFu << 8u) | (1u << 22u);
    bool sourceAOnlyLine = !sourceAOnly
        || (sourceAKind >= 1u && sourceAKind <= 2u
            && (route.x & ~sourceAOnlyLineMask) == 0u
            && route.z == expectedCaptureParameters
            && route.w == 0u);
    return (route.x & 1u) != 0u
        && lineKeyPresent == sourceAUses3d
        && (!sourceAUses3d || all(equal(renderKey, headerRenderKey)))
        && sourceAOnlyLine;
}

bool causalLoadCaptureRecipeLine(uint line, out uvec4 route,
                                 out uvec4 renderKey)
{
    uvec4 productKey;
    uvec4 headerRenderKey;
    uvec4 metadata;
    return causalCaptureRecipeHeader(
            productKey, headerRenderKey, metadata)
        && causalLoadCaptureRecipeLineValidated(
            line, headerRenderKey, metadata, route, renderKey);
}

bool captureRecipeUsesSourceAOnly(uint flags)
{
    return kSpecializedCaptureRecipeEncoding == 1u
        || (kSpecializedCaptureRecipeEncoding == 0xFFFFFFFFu
            && (flags & (1u << 8u)) != 0u);
}

bool causalLoadCapturePixelRecipe(uint x, uint line,
                                  bool sourceAOnly,
                                  out uvec4 recipeA,
                                  out uvec4 recipeB,
                                  out uvec4 recipeC)
{
    recipeA = uvec4(0u);
    recipeB = uvec4(0u);
    recipeC = uvec4(0u);
    if (x >= 256u || line >= 192u)
        return false;
    uint pixel = line * 256u + x;
    uint wordsPerPixel = sourceAOnly ? 4u : 12u;
    uint word = kCausalCaptureRecipePixelOffsetWords
        + pixel * wordsPerPixel;
    if (word + wordsPerPixel > kCausalCaptureMaterialOffsetWords)
        return false;
    recipeA = uvec4(causal[word + 0u], causal[word + 1u],
                    causal[word + 2u], causal[word + 3u]);
    if (sourceAOnly)
    {

        recipeC.y = 1u << 24u;
        return true;
    }
    recipeB = uvec4(causal[word + 4u], causal[word + 5u],
                    causal[word + 6u], causal[word + 7u]);
    recipeC = uvec4(causal[word + 8u], causal[word + 9u],
                    causal[word + 10u], causal[word + 11u]);
    return true;
}

bool causalLoadCaptureMaterial(uint x, uint line, out uint packed)
{
    packed = 0u;
    if (x >= 256u || line >= 192u)
        return false;
    uint pixel = line * 256u + x;
    uint word = kCausalCaptureMaterialOffsetWords + pixel / 2u;
    if (word >= kCausalTotalWords)
        return false;
    uint pair = causal[word];
    packed = (pixel & 1u) == 0u ? (pair & 0xFFFFu) : (pair >> 16u);
    return true;
}

