{
    uint xSalida = gl_GlobalInvocationID.x;
    uint filaSalida = gl_GlobalInvocationID.y;

    if (outputMode() == 4u || outputMode() == 5u
        || (outputMode() == 2u && pc.mezcla != 0u))
