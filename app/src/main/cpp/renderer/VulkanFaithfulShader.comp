        h5StoreSlot(slot, ivec2(int(xSalida), int(filaSalida)), captureColor);
        return;
    }

    if (outputMode() == 5u)
    {
        uint slot = (pc.escala >> 25u) & 3u;
        uint materialParity = (pc.escala >> 27u) & 1u;
        uint outputScale = max(pc.escala & 0xFFu, 1u);
        bool sourceSealDiagnostic =
            (pc.mezcla & 0x80000000u) != 0u;
        if (gl_LocalInvocationID.x == 0u)
        {
            materialSealGroupMismatches = 0u;
            materialSealGroupSourceMismatches = 0u;
        }
        barrier();

        if (gl_LocalInvocationID.x == 0u)
